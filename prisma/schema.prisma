  serviceAreas             String[] @default(["Hyderabad", "Bengaluru", "Vijayawada"])
  instagram                String?
  pinterest                String?
  googleMapsEmbedUrl       String?
  googleMapsUrl            String?
  googleBusinessProfileUrl String?
  announcementEnabled      Boolean  @default(false)
  announcementText         String?
  announcementHref         String?
  heroEyebrow              String   @default("Interior design studio - Hyderabad")
  heroTitle                String   @default("A home that feels like a deep breath.")
  heroDescription          String   @default("Thoughtful, layered interiors for people who value the quiet luxury of home. We design spaces that hold your everyday life beautifully.") @db.Text
  heroImage                String   @default("https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2000&q=85")
  aboutStory               String   @db.Text
  philosophy               String   @db.Text
  aboutImage               String
  founderName              String   @default("Ananya Rao")
  founderRole              String   @default("Founder & Principal Designer")
  founderImage             String?
  yearsExperience          Int      @default(12)
  projectsCompleted        Int      @default(180)
  citiesServed             Int      @default(6)
  values                   Json
  team                     Json
  whyChooseUs              Json
  homeProjectsEyebrow      String   @default("Selected work")
  homeProjectsTitle        String   @default("Spaces with a sense of\nquiet permanence.") @db.Text
  homeProjectsDescription  String   @default("A selection of homes and workspaces shaped around the people who live and work in them.") @db.Text
  homeServicesEyebrow      String   @default("What we do")
  homeServicesTitle        String   @default("From the first\nsketch to the final\ncushion.") @db.Text
  homeServicesDescription  String   @default("A full-service studio for residential and commercial interiors, with every detail handled under one roof.") @db.Text
  homeProductsEyebrow      String   @default("The collection")
  homeProductsTitle        String   @default("Objects that make\na house feel yours.") @db.Text
  homeProductsDescription  String   @default("A considered collection of furniture, lighting, textiles, and objects - made in small batches by craftspeople we trust.") @db.Text
  homeWhyEyebrow           String   @default("Why Ivory & Oak")
  homeWhyTitle             String   @default("A studio built on\ntrust and detail.") @db.Text
  homeWhyDescription       String   @default("We keep our projects limited so every home gets the attention it deserves. That means a small, senior team and one accountable point of contact.") @db.Text
  homeTestimonialsEyebrow  String   @default("In their words")
  homeTestimonialsTitle    String   @default("Good homes.\nGenuine people.") @db.Text
  homeCtaEyebrow           String   @default("Begin a project")
  homeCtaTitle             String   @default("Let's design a home you'll never want to leave.") @db.Text
  homeCtaDescription       String   @default("Tell us about your space, your routines, and what you're dreaming of. We'll take it from there.") @db.Text
  homeCtaImage             String?
  footerDescription        String   @default("A Hyderabad-based interior design studio creating thoughtful, layered spaces across South India.") @db.Text
  footerNote               String?  @db.Text
  seoTitle                 String   @default("Ivory & Oak | Interior Design Studio, Hyderabad")
  seoDescription           String   @default("Thoughtful, layered interiors for homes and workspaces across Hyderabad and South India. Residential interiors, modular kitchens, wardrobes and commercial design.") @db.Text
  seoKeywords              String[] @default([])
