# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Use a local Postgres database, or a hosted
# provider such as Neon or Supabase. Add ?sslmode=require for hosted databases
# when instructed by your provider.
DATABASE_URL="postgresql://postgres:password@localhost:5432/ivory_oak?schema=public"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Initial admin account created by `npm run db:seed`.
# The password is hashed with bcrypt; it is never stored in plain text.
ADMIN_EMAIL="admin@ivoryandoak.in"
ADMIN_NAME="Studio Admin"
ADMIN_PASSWORD="change-this-password-before-seeding"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Search Console HTML verification token. Do not include the meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Optional: GA4 measurement ID (for example G-XXXXXXXXXX). Leave blank to
# disable analytics. Review your privacy policy and consent requirements first.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ---------------------------------------------------------------------------
# Enquiry email notifications
# ---------------------------------------------------------------------------
# Optional. Inquiries are always saved to the database. To also email the
# studio through Resend, set all three values. Verify the sending domain in
# Resend before using it here.
RESEND_API_KEY=""
INQUIRY_FROM_EMAIL="Ivory & Oak <enquiries@yourdomain.com>"
INQUIRY_NOTIFICATION_EMAIL="studio@ivoryandoak.in"

# ---------------------------------------------------------------------------
# Cloudinary (admin image uploads)
# ---------------------------------------------------------------------------
# Create a free account at https://cloudinary.com and copy these from the
# dashboard. Uploads are disabled, but URL entry remains available, if unset.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="ivory-and-oak"
